<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.common.code.mapper.CommonCodeMapper">

    <resultMap id="commonCodeMap" type="com.example.demo.common.code.model.CommonCode">
        <id property="codeId" column="code_id"/>
        <result property="groupCode" column="group_code"/>
        <result property="codeName" column="code_name"/>
        <result property="codeValue" column="code_value"/>
        <result property="description" column="description"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <select id="findAll" resultMap="commonCodeMap">
        SELECT code_id, group_code, code_name, code_value, description, sort_order
        FROM common_code
        ORDER BY group_code, sort_order
    </select>

    <select id="findByGroupCode" resultMap="commonCodeMap">
        SELECT code_id, group_code, code_name, code_value, description, sort_order
        FROM common_code
        WHERE group_code = #{groupCode}
        ORDER BY sort_order
    </select>

</mapper>
